# Example environment file

# Project-relative roots
PROJECT_ROOT="."
SHARED_DIR="./shared"
KB_ROOT="./knowledge-base"

# Agent workspaces (names are placeholders; rename to fit your repo)
WORKSPACE_COLLECTOR="./workspace-collector"
WORKSPACE_SENTINEL="./workspace-sentinel"
WORKSPACE_LIBRARIAN="./workspace-librarian"
WORKSPACE_EDITOR="./workspace-editor"

# Retrieval runtime
KB_EMBEDDINGS_ENABLED="1"
EMBEDDING_PROVIDER_KEY=""

# Delivery hooks
SEND_REPORTS_HOOK="0"
REPORT_DELIVERY_HOOK=""

# Collector toggles
ENABLE_AINEWS_FETCH="1"
ENABLE_XDIGEST_FETCH="1"
ENABLE_YOUTUBE_FETCH="1"

# Replace these with your own implementation details
AINEWS_SOURCE_NOTES="Replace stub fetcher with your own source logic"
XDIGEST_SOURCE_NOTES="Replace stub fetcher with your own tracked-account logic"
YOUTUBE_SOURCE_NOTES="Replace stub fetcher with your own video/transcript logic"
