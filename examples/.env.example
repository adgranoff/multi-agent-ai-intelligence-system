# Multi-Agent AI Intelligence System
# Example environment file

# Base paths
SYSTEM_HOME="$HOME/multi-agent-intelligence"
SHARED_DIR="$SYSTEM_HOME/shared"
KB_ROOT="$SYSTEM_HOME/knowledge-base"

# Collector
WORKSPACE_COLLECTOR="$SYSTEM_HOME/workspace-collector"

# Sentinel
WORKSPACE_SENTINEL="$SYSTEM_HOME/workspace-sentinel"
SENTINEL_OUTPUT_DIR="$SHARED_DIR/sentinel-output"

# Librarian
WORKSPACE_LIBRARIAN="$SYSTEM_HOME/workspace-librarian"

# ModelScout
WORKSPACE_MODELSCOUT="$SYSTEM_HOME/workspace-modelscout"

# Advanced KB / embeddings
OPENROUTER_API_KEY=""
KB_EMBEDDINGS_ENABLED="1"

# Delivery examples
SEND_REPORTS_HOOK="0"
REPORT_DELIVERY_HOOK=""

# Collector source toggles
ENABLE_AINEWS_FETCH="1"
ENABLE_XDIGEST_FETCH="1"
ENABLE_YOUTUBE_FETCH="1"

# Replace these with your own implementation details
AINEWS_SOURCE_NOTES="Replace stub fetcher with your own source logic"
XDIGEST_SOURCE_NOTES="Replace stub fetcher with your own tracked accounts logic"
YOUTUBE_SOURCE_NOTES="Replace stub fetcher with your own channel/transcript logic"
