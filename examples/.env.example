# OpenClaw Multi-Agent AI Intelligence System
# Example environment file

# Base paths
OPENCLAW_HOME="$HOME/.openclaw"
SHARED_DIR="$OPENCLAW_HOME/shared"
KB_ROOT="$OPENCLAW_HOME/knowledge-base"

# Collector
WORKSPACE_COLLECTOR="$OPENCLAW_HOME/workspace-collector"

# Sentinel
WORKSPACE_SENTINEL="$OPENCLAW_HOME/workspace-sentinel"
SENTINEL_OUTPUT_DIR="$SHARED_DIR/sentinel-output"

# Librarian
WORKSPACE_LIBRARIAN="$OPENCLAW_HOME/workspace-librarian"

# ModelScout
WORKSPACE_MODELSCOUT="$OPENCLAW_HOME/workspace-modelscout"

# Advanced KB / embeddings
OPENROUTER_API_KEY=""
KB_EMBEDDINGS_ENABLED="1"

# Delivery examples
SEND_REPORTS_TELEGRAM="0"
TELEGRAM_CHANNEL="telegram"
TELEGRAM_TARGET="CHANGE_ME"

# Collector source toggles
ENABLE_AINEWS_FETCH="1"
ENABLE_XDIGEST_FETCH="1"
ENABLE_YOUTUBE_FETCH="1"

# Replace these with your own implementation details
AINEWS_SOURCE_NOTES="Replace stub fetcher with your own source logic"
XDIGEST_SOURCE_NOTES="Replace stub fetcher with your own tracked accounts logic"
YOUTUBE_SOURCE_NOTES="Replace stub fetcher with your own channel/transcript logic"

