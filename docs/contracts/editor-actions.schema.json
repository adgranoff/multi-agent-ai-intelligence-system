{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editor-actions.schema.json",
  "title": "Editor Actions Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "date",
    "mode",
    "summary",
    "actions"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "weekly-curation",
        "rerun-verification"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target",
          "reason"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "promote_company",
              "demote_company",
              "promote_theme",
              "demote_theme",
              "archive_opportunity",
              "archive_content_idea"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
